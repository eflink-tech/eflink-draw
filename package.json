{
  "name": "eflink-draw-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:demo": "pnpm --filter eflink-draw-demo dev",
    "build": "pnpm --filter @eflink-tech/draw build && pnpm --filter eflink-draw-demo build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @eflink-tech/draw test",
    "test:watch": "pnpm --filter @eflink-tech/draw test:watch",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:ci": "bash scripts/release-ci.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.62.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  }
}
